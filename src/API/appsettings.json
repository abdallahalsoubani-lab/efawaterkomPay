{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=DirectPayGateway.db"
  },
  "JwtSettings": {
    "Secret": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS_HERE_CHANGE_IN_PRODUCTION",
    "ExpiryInDays": 7,
    "Issuer": "DirectPayGateway",
    "Audience": "DirectPayGateway"
  },
  "DirectPay": {
    "BillerCode": "YOUR_BILLER_CODE_HERE",
    "ServiceCode": "YOUR_SERVICE_CODE_HERE",
    "SecretToken": "YOUR_SECRET_TOKEN_HERE",
    "CallbackUrl": "https://yourdomain.com/api/payment/callback",
    "BaseUrl": {
      "Staging": "https://staging.efawateercom.jo/DirectPayService/DirectPay.aspx",
      "Production": "https://www.efawateercom.jo/DirectPayService/DirectPay.aspx"
    },
    "Environment": "Staging",
    "Currency": "JOD",
    "Language": "AR"
  },
"CtmIntegration": {
    "BillerCode": "1227",
    "SdrCode": "1227", 
    "Currency": "JOD",
    "DefaultServiceType": "OunDonations",
    "BasicAuth": {
      "Username": "oun_ctm_user",
      "Password": "Oun@CTM2026!Secure"
    },
    "CampaignSeedFile": "campaigns-seed.json"
},
  "FrontendUrl": "http://localhost:3000",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5000",
      "http://localhost:5050",
      "https://yourdomain.com"
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*:/api/payment/initiate",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "*:/api/auth/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*:/api/auth/register",
        "Period": "1h",
        "Limit": 10
      },
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 10
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}