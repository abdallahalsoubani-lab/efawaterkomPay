# Database Connection
DATABASE_CONNECTION_STRING=Server=localhost;Database=DirectPayGateway;Trusted_Connection=true;TrustServerCertificate=true;

# JWT Settings
JWT_SECRET=YOUR_JWT_SECRET_KEY_MIN_32_CHARS_HERE_CHANGE_IN_PRODUCTION
JWT_EXPIRY_DAYS=7
JWT_ISSUER=DirectPayGateway
JWT_AUDIENCE=DirectPayGateway

# DirectPay Configuration (eFAWATEERcom)
DIRECTPAY_BILLER_CODE=YOUR_BILLER_CODE_HERE
DIRECTPAY_SERVICE_CODE=YOUR_SERVICE_CODE_HERE
DIRECTPAY_SECRET_TOKEN=YOUR_SECRET_TOKEN_HERE
DIRECTPAY_CALLBACK_URL=https://yourdomain.com/api/payment/callback
DIRECTPAY_ENVIRONMENT=Staging
# Use "Production" when going live

# CTM Integration (eFAWATEERcom Biller-Side JSON API)
CTM_BILLER_CODE=YOUR_BILLER_CODE
CTM_SDR_CODE=YOUR_SDR_CODE
CTM_BASIC_AUTH_USERNAME=YOUR_CTM_USERNAME
CTM_BASIC_AUTH_PASSWORD=YOUR_CTM_PASSWORD

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:3000

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# API URL (for frontend build)
API_URL=http://localhost:5000
